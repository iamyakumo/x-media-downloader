<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ always draws a system splash until the first frame.
      Match the main UI background and use a transparent animated icon so
      there is no centered launcher logo / branded splash — feels like going
      straight into MainActivity. No androidx.core:core-splashscreen dependency.
    -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/accent_pressed</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:statusBarColor">@color/bg_page</item>
        <item name="android:navigationBarColor">@color/bg_page</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>

        <item name="android:windowSplashScreenBackground">@color/bg_page</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
